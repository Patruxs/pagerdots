<?xml version="1.0" encoding="UTF-8"?>
<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.kde.org/standards/kcfg/1.0
      http://www.kde.org/standards/kcfg/1.0/kcfg.xsd">
  <kcfgfile name=""/>

  <group name="General">
    <!-- How the non-current desktops are labelled. See labelFor() in main.qml. -->
    <entry name="labelStyle" type="String">
      <default>numbers</default>
    </entry>
    <!-- Show the current desktop as a dot (true) or as its own label (false). -->
    <entry name="dotForCurrent" type="Bool">
      <default>true</default>
    </entry>
    <!-- Colour of the dot: the text colour ("text") or the accent colour ("accent"). -->
    <entry name="dotColor" type="String">
      <default>text</default>
    </entry>
    <!-- Gap between neighbouring desktops, in pixels. -->
    <entry name="spacing" type="Int">
      <default>6</default>
    </entry>
    <!-- How the dot moves to the new desktop. See MODES in Animations.js. -->
    <entry name="dotAnimation" type="String">
      <default>stretch</default>
    </entry>
    <!-- Whether the "pill" label style uses dotAnimation rather than the GNOME-style
         animation it comes with (PILL_ANIMATION in Animations.js). -->
    <entry name="pillCustomAnimation" type="Bool">
      <default>false</default>
    </entry>
    <!-- Whether the "pill" label style uses `spacing` rather than the GNOME-style gap
         between its dots (PILL_GAP in Labels.js). -->
    <entry name="pillCustomSpacing" type="Bool">
      <default>false</default>
    </entry>
    <!-- Speed of the dot animation as a percentage of normal: 50 is half speed, 200 double. -->
    <entry name="animationSpeed" type="Int">
      <default>100</default>
      <min>25</min>
      <max>400</max>
    </entry>
  </group>

  <group name="Behavior">
    <!-- Whether the mouse wheel over the widget steps through the desktops. -->
    <entry name="wheelSwitches" type="Bool">
      <default>true</default>
    </entry>
    <!-- Whether stepping past the last desktop comes round to the first, and vice versa. -->
    <entry name="wheelWrap" type="Bool">
      <default>true</default>
    </entry>
    <!-- Whether scrolling down goes to the previous desktop rather than the next. -->
    <entry name="wheelInvert" type="Bool">
      <default>false</default>
    </entry>
    <!-- What a click on the current desktop does: "nothing", "showDesktop", "overview"
         or "grid" (the last three through KWin's shortcuts of those names). -->
    <entry name="currentDesktopClick" type="String">
      <default>nothing</default>
    </entry>
    <!-- Whether that also happens on a click anywhere else on the widget. -->
    <entry name="currentDesktopClickAnywhere" type="Bool">
      <default>true</default>
    </entry>
    <!-- Whether hovering a desktop shows a tooltip with its name. -->
    <entry name="tooltips" type="Bool">
      <default>true</default>
    </entry>
    <!-- Whether that tooltip lists the windows on the desktop. -->
    <entry name="tooltipWindows" type="Bool">
      <default>true</default>
    </entry>
    <!-- Whether the context menu offers to add a desktop and remove the last one. -->
    <entry name="manageDesktops" type="Bool">
      <default>true</default>
    </entry>
    <!-- Whether the context menu offers to rename the current desktop. -->
    <entry name="renameDesktop" type="Bool">
      <default>true</default>
    </entry>
    <!-- Whether desktops are added and removed on their own, as in GNOME: one empty
         desktop at the end, always. -->
    <entry name="autoDesktops" type="Bool">
      <default>false</default>
    </entry>
    <!-- What a new desktop is called, numbered ("Work 3"); empty for KWin's default. -->
    <entry name="newDesktopName" type="String">
      <default></default>
    </entry>
  </group>
</kcfg>
